{
  "version": "2.0.0",
  "note": "Repacks: conjuntos multi-ferramenta instaláveis em 1 comando. Passos declarativos; nada executa operação fictícia.",
  "repacks": [
    {
      "id": "frame-gen-starter",
      "name": "Frame Gen Starter",
      "version": "2.0.0",
      "description": "Kit inicial: detecção de engines, orçamento de pixels e plano de quadros para jogos.",
      "tools": ["engines.detect", "frames.budget", "frames.plan", "perf.monitor"],
      "requires": ["navegador com WebGL2"],
      "steps": [
        { "tool": "engines.detect", "label": "Detectar engines disponíveis" },
        { "tool": "frames.budget", "label": "Calibrar orçamento de pixels/fps" },
        { "tool": "frames.plan", "label": "Gerar plano de quadros" }
      ],
      "state": "ready"
    },
    {
      "id": "gguf-analyst",
      "name": "GGUF Analyst",
      "version": "2.0.0",
      "description": "Análise completa de modelos .gguf no cliente + estimativa de quantização.",
      "tools": ["metadata.parse", "quantization.estimate", "quantization.plan", "models.register"],
      "requires": ["arquivo .gguf local"],
      "steps": [
        { "tool": "metadata.parse", "label": "Parsear metadados GGUF" },
        { "tool": "quantization.estimate", "label": "Estimar tamanhos por quantização" },
        { "tool": "quantization.plan", "label": "Planejar conversão (runtime externo)" },
        { "tool": "models.register", "label": "Registrar no catálogo local" }
      ],
      "state": "ready"
    },
    {
      "id": "video-enhancer",
      "name": "Video Enhancer",
      "version": "2.0.0",
      "description": "Sonda e plano de aprimoramento para .mp4 (fps alvo, escala, cenas).",
      "tools": ["videos.probe", "engines.detect", "videos.plan", "jobs.create"],
      "requires": ["arquivo .mp4 local"],
      "steps": [
        { "tool": "videos.probe", "label": "Sondar vídeo" },
        { "tool": "engines.detect", "label": "Detectar engines" },
        { "tool": "videos.plan", "label": "Gerar plano de aprimoramento" },
        { "tool": "jobs.create", "label": "Registrar job planejado" }
      ],
      "state": "ready"
    },
    {
      "id": "lmstudio-bridge",
      "name": "LM Studio Bridge",
      "version": "2.0.0",
      "description": "Conecta o FGUA ao LM Studio (OpenAI-compat + REST v1) para execução real.",
      "tools": ["lmstudio.models.list", "lmstudio.chat", "models.load", "engines.select"],
      "requires": ["LM Studio com servidor ativado e CORS habilitado"],
      "steps": [
        { "tool": "lmstudio.models.list", "label": "Listar modelos do LM Studio" },
        { "tool": "models.load", "label": "Carregar modelo (POST /api/v1/models/load)" },
        { "tool": "lmstudio.chat", "label": "Teste de chat (POST /api/v1/chat ou /v1/chat/completions)" },
        { "tool": "engines.select", "label": "Selecionar engine" }
      ],
      "state": "requires-provider"
    }
  ]
}
