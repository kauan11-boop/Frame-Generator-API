{
  "version": "2.0.0",
  "note": "Permissões em nível de UI. Autorização confiável exige backend. Sem segredos em arquivos públicos.",
  "roles": {
    "admin": {
      "label": "Administrador",
      "permissions": [
        "public", "models.read", "models.register", "models.load",
        "quant.plan", "gen.plan", "repack.manage", "users.manage",
        "config.manage", "storage.write", "security.manage"
      ]
    },
    "operador": {
      "label": "Operador",
      "permissions": [
        "public", "models.read", "models.register", "quant.plan",
        "gen.plan", "repack.manage", "storage.write"
      ]
    },
    "visitante": {
      "label": "Visitante",
      "permissions": ["public", "models.read", "gen.plan"]
    }
  },
  "namespaceGuard": {
    "system": "public",
    "models": "models.read",
    "metadata": "models.read",
    "quantization": "quant.plan",
    "generators": "gen.plan",
    "frames": "gen.plan",
    "images": "gen.plan",
    "videos": "gen.plan",
    "engines": "public",
    "repack": "repack.manage",
    "tools": "public",
    "users": "users.manage",
    "permissions": "public",
    "config": "config.manage",
    "jobs": "gen.plan",
    "storage": "storage.write"
  },
  "users": [
    { "id": "admin", "name": "Administrador", "role": "admin", "passwordHash": null, "avatar": "A" },
    { "id": "operador", "name": "Operador Local", "role": "operador", "passwordHash": null, "avatar": "O" },
    { "id": "visitante", "name": "Visitante", "role": "visitante", "passwordHash": null, "avatar": "V" }
  ],
  "policy": {
    "maxFailedLogins": 5,
    "lockSeconds": 30,
    "sessionStorage": "local",
    "passwordHash": "SHA-256 + salt local (UI-level; não é autorização de servidor)"
  }
}
