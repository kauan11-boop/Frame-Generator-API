{
  "base": "/api/v1",
  "mode": "demo",
  "backend": {
    "localUrl": null,
    "remoteUrl": null,
    "connected": false
  },
  "namespaces": [
    "/api/v1/system/",
    "/api/v1/models/",
    "/api/v1/metadata/",
    "/api/v1/quantization/",
    "/api/v1/generators/",
    "/api/v1/frames/",
    "/api/v1/images/",
    "/api/v1/videos/",
    "/api/v1/engines/",
    "/api/v1/repack/",
    "/api/v1/tools/",
    "/api/v1/users/",
    "/api/v1/permissions/",
    "/api/v1/config/",
    "/api/v1/jobs/",
    "/api/v1/storage/",
    "/api/v1/integrations/",
    "/api/v1/websocket/",
    "/api/v1/discord/",
    "/api/v1/analytics/"
  ],
  "integrations": {
    "websocket": {
      "clientSupported": true,
      "serverIncluded": false,
      "authCodeOptional": true,
      "note": "Cliente WebSocket disponível no navegador; servidor/endpoint real deve ser fornecido e executado fora do GitHub Pages."
    },
    "discord": {
      "runtime": "nodejs",
      "library": "discord.js",
      "staticGenerator": true,
      "note": "Configuração e geração de templates no site; execução do bot requer ambiente Node.js externo."
    },
    "reactVite": {
      "templatePath": "integrations/react-vite",
      "githubPagesCompatible": true,
      "note": "Scaffold React + Vite para integração e deploy estático."
    }
  }
}
