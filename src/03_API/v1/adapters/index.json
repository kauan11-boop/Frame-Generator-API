{
  "version": "1.0.0",
  "updated_at": "2026-11-19T00:00:00Z",
  "etag": "adp-20261119-01",
  "description": "Adaptadores para conectar a API estática a executores externos e modos locais/wasm.",
  "adapters": [
    {
      "id": "adapter-external-http",
      "type": "http",
      "modes": ["A_external_runner", "hybrid"],
      "supports": ["models.list", "models.get", "models.register", "models.inspect_gguf", "frames.create", "frames.get", "frames.list", "frames.cancel", "packages.install", "packages.update", "repack.plan", "repack.apply"],
      "config": { "base_url": "https://your-backend.example.com", "auth": "bearer|api_key|none", "timeout_ms": 60000 },
      "notes": "Backend próprio (Node/Python/etc.) para execução real."
    },
    {
      "id": "adapter-openai-compatible",
      "type": "http-openai",
      "modes": ["A_external_runner"],
      "supports": ["models.list", "frames.create"],
      "config": { "base_url": "http://localhost:1234/v1", "endpoints": { "models": "/models", "chat": "/chat/completions" }, "auth": "bearer|none" },
      "notes": "Compatível com LM Studio/Ollama/llama.cpp server/OpenAI-like."
    },
    {
      "id": "adapter-cloudflare-worker",
      "type": "http-worker",
      "modes": ["B_external_backend_adapters", "hybrid"],
      "supports": ["models.register", "frames.create", "frames.get", "packages.install", "packages.update", "repack.plan", "repack.apply"],
      "config": { "base_url": "https://<worker>.workers.dev", "bindings": ["KV", "D1", "R2", "AI?"] },
      "notes": "Opção B: backend serverless para escrita/controle/orquestração."
    },
    {
      "id": "adapter-wasm-browser",
      "type": "wasm",
      "modes": ["B_wasm_experimental"],
      "supports": ["models.inspect_gguf", "frames.create(plan-only)"] ,
      "config": { "engine": "wllama|llama-cpp-wasm", "model_uri": "cdn://...", "threads": "auto" },
      "limits": "Experimental: modelos pequenos, alto uso de memória; sem descompilação de pesos; recomendado para inspeção/planejamento leve."
    },
    {
      "id": "adapter-static-readonly",
      "type": "static",
      "modes": ["A_static_pages"],
      "supports": ["system.status", "models.list", "models.get", "packages.list", "repack.status", "sync.manifest"],
      "config": { "base_url": "./" },
      "notes": "Leitura direta dos JSONs hospedados no GitHub Pages."
    }
  ]
}
