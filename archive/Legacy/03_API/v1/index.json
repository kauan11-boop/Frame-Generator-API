{
  "name": "Frame-Generator-API",
  "version": "1.0.0",
  "updated_at": "2026-11-19T00:00:00Z",
  "etag": "idx-20261119-03",
  "kind": "static-unified-api",
  "deployment": {
    "provider": "github-pages",
    "site": "https://kauan11-boop.github.io/Frame-Generator-API/",
    "interface": "https://kauan11-boop.github.io/Frame-Generator-API/Public/dashboard.html",
    "api_base": "https://kauan11-boop.github.io/Frame-Generator-API/src",
    "discovery": "https://kauan11-boop.github.io/Frame-Generator-API/src/03_API/v1/index.json"
  },
  "hosting": {
    "mode": "hybrid-configurable",
    "options": {
      "A_static_pages": true,
      "B_external_backend_adapters": true,
      "C_hybrid": true
    },
    "notes": "GitHub Pages serve recursos estáticos. Execução pesada via adaptadores externos."
  },
  "capabilities": {
    "model_registry": true,
    "model_loader_metadata": true,
    "frame_generation": true,
    "packages": true,
    "commands": true,
    "repack": true,
    "auto_adjust_manifests": true,
    "integration_prompt": true
  },
  "frame_modes": {
    "storyboard": { "enabled": true, "description": "Quadros de roteiro visual/cenas com prompts e metadados." },
    "video_frames": { "enabled": true, "description": "Sequência de frames para vídeo/animação." },
    "data_panels": { "enabled": true, "description": "Quadros de dados/UI (cards, painéis, tabelas)." },
    "composite": { "enabled": true, "description": "Composição mista de modos." }
  },
  "gguf_modes": {
    "A_external_runner": { "enabled": true, "runners": ["llama.cpp-server", "ollama", "lm-studio", "openai-compatible", "custom-http"] },
    "B_wasm_experimental": { "enabled": true, "engines": ["wllama", "llama-cpp-wasm"], "limits": "Modelos pequenos, memória/CPU do navegador, sem descompilação de pesos." },
    "C_catalog_metadata_only": { "enabled": true }
  },
  "protocol": {
    "format": "application/json",
    "request_envelope": "12_Validation/command.schema.json",
    "response_envelope": "12_Validation/response.schema.json",
    "restrictions": {
      "max_body_bytes": 1048576,
      "allowlisted_commands": true,
      "schema_validation": "required",
      "auth": "adapter-dependent (bearer/api-key/none for public read)"
    }
  },
  "endpoints": {
    "self": "03_API/v1/index.json",
    "models": "03_API/v1/models/index.json",
    "frames": "03_API/v1/frames/index.json",
    "frame_templates": "03_API/v1/frames/templates.json",
    "packages": "03_API/v1/packages/index.json",
    "commands": "03_API/v1/commands/index.json",
    "repack": "03_API/v1/repack/index.json",
    "adapters": "03_API/v1/adapters/index.json",
    "system_status": "03_API/v1/system/status.json",
    "integration_prompt": "03_API/v1/prompts/integration.json",
    "content": "03_API/v1/content/index.json",
    "schemas": "12_Validation/",
    "sdk": "15_Integration/sdk/frame-api.js",
    "interface": "../../Public/dashboard.html"
  },
  "sync": {
    "strategy": "manifest-polling",
    "fields": ["version", "updated_at", "etag"],
    "recommended_interval_sec": 60
  }
}
