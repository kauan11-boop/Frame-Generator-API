{
  "id": "sample-repack",
  "name": "Repack de Exemplo (manifest)",
  "version": "2.0.0",
  "description": "Manifest de exemplo que mostra como empacotar várias ferramentas em 1 comando. Carregue-o via repack.addLocal no Terminal ou copie como base para novos repacks.",
  "tools": ["engines.detect", "frames.budget", "frames.plan", "jobs.create"],
  "requires": ["navegador moderno"],
  "steps": [
    { "tool": "engines.detect", "label": "Detectar engines" },
    { "tool": "frames.budget", "label": "Calibrar orçamento de pixels" },
    { "tool": "frames.plan", "label": "Gerar plano de quadros (jogos)" },
    { "tool": "jobs.create", "label": "Registrar job planejado" }
  ],
  "state": "ready"
}
