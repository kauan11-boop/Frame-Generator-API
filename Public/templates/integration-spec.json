{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FGUA-integration-spec",
  "identity": {
    "name": "Frame-Generator-API",
    "acronym": "FGUA",
    "version": "2.0.0",
    "runtime": "HTML5 + CSS3 + JavaScript (ES Modules)",
    "hosting": "GitHub Pages (estático)",
    "license": "MIT",
    "repository": "https://github.com/kauan11-boop/Frame-Generator-API",
    "site": "https://kauan11-boop.github.io/Frame-Generator-API/"
  },
  "contract": "/api/v1",
  "modes": ["demo", "local", "remote"],
  "defaultMode": "demo",
  "namespaces": [
    "system", "models", "metadata", "quantization", "generators", "frames",
    "images", "videos", "engines", "repack", "tools", "users", "permissions",
    "config", "jobs", "storage"
  ],
  "states": [
    "ready", "planned", "analyzed", "requires-provider", "requires-runtime",
    "unavailable", "invalid", "failed", "cancelled", "succeeded"
  ],
  "limits": {
    "gguf": "Análise de metadados no cliente (header/KV/tensores, orçamento 32 MB). Inferência real exige runtime/provedor compatível.",
    "quantization": "Identificação/estimativa/planejamento apenas; conversão efetiva em runtime externo (ex.: llama-quantize); arquivo original sempre preservado; sem conversão fictícia.",
    "generation": "Planejamento/análise com estados explícitos; execução real depende de engine/modelo/provedor compatível; sem simulação.",
    "security": "UI-level; autorização confiável exige backend; sem segredos em arquivos públicos; senhas locais com SHA-256+salt.",
    "games": "Sem interceptação automática de pipeline gráfico; apenas integrações/capturas autorizadas."
  },
  "runtimes": {
    "detection": ["webgpu", "webgl2", "webgl", "wasm+simd", "webcodecs", "workers", "opfs"],
    "tensorflowjs": { "package": "@tensorflow/tfjs", "version": "4.22.0", "load": "sob demanda (CDN)", "backends": ["webgpu", "webgl", "cpu"] },
    "transformersjs": { "package": "@huggingface/transformers", "version": "3.7.5", "load": "sob demanda (CDN)", "devices": ["webgpu", "wasm"] }
  },
  "lmstudio": {
    "defaultBaseUrl": "http://localhost:1234",
    "openaiCompat": ["/v1/models", "/v1/chat/completions", "/v1/completions", "/v1/embeddings", "/v1/responses"],
    "nativeV1": ["/api/v1/models", "/api/v1/chat", "/api/v1/models/load", "/api/v1/models/unload", "/api/v1/models/download", "/api/v1/models/download/status"],
    "nativeV0": ["/api/v0/models", "/api/v0/models/{model}", "/api/v0/chat/completions", "/api/v0/completions", "/api/v0/embeddings"],
    "corsRequired": true,
    "auth": "Authorization: Bearer <token> (opcional; Manage Tokens no LM Studio)"
  },
  "repacks": ["frame-gen-starter", "gguf-analyst", "video-enhancer", "lmstudio-bridge"],
  "resources": {
    "desktop": "/Public/desktop/index.html",
    "dashboard": "/Public/dashboard.html",
    "documentation": "/Public/documentation/index.html",
    "masterPrompt": "/Public/templates/master-prompt-integration.md",
    "jobTemplate": "/Public/templates/job-template.json",
    "sampleRepack": "/Public/manifests/sample-repack.json",
    "presets": "/Public/presets/default-presets.json",
    "configs": "/configs/*.json"
  },
  "commands": {
    "install": "npm install",
    "serve": "npm run serve (http://localhost:4173)",
    "verify": "npm run ci",
    "test": "npm run test",
    "publish": "git push -u origin main (GitHub Pages: main / root)"
  }
}
