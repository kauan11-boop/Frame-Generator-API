{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response.schema.json",
  "title": "Unified Response Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "request_id", "command", "data"],
  "properties": {
    "ok": { "type": "boolean" },
    "request_id": { "type": "string" },
    "command": { "type": "string" },
    "data": {},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" },
        "etag": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
